# ====== Turso database (SQLite cloud) ======
# Create a free database at https://turso.tech then fill these two values.
# When they are both filled, the site uses the Turso cloud database.
# When they are empty, the site uses a local file (data.db) so you can work offline.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ====== Server ======
# Port used by the Express server (API + production site).
PORT=3001

# Public base URL of the site. Used for the Google OAuth redirect
# (keep this = the port you actually open the site on).
APP_URL="http://localhost:3001"

# ====== Google sign-in (required for the site login button) ======
# From Google Cloud Console -> Credentials -> OAuth client ID (Web application).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Add this exact redirect URI to the client's "Authorized redirect URIs":
#   <APP_URL>/api/auth/google/callback

# ====== Web Push (phone notifications) ======
# Generate a key pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ====== Existing / AI Studio ======
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"